{
  "opencollection": "1.0.0",
  "info": {
    "name": "Signaturely Documents User API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signaturely.com/api/v1/user/by-api"
          },
          "docs": "Retrieve information about the user account tied to your API key."
        }
      ]
    }
  ],
  "bundled": true
}