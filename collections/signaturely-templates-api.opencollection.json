{
  "opencollection": "1.0.0",
  "info": {
    "name": "Signaturely Documents Templates API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signaturely.com/api/v1/documents/api/templates"
          },
          "docs": "Get the list of templates available to your account via API."
        },
        {
          "info": {
            "name": "Delete a template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.signaturely.com/api/v1/documents/api/templates"
          },
          "docs": "Delete a template"
        },
        {
          "info": {
            "name": "Download a template file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.signaturely.com/api/v1/document_sign/documents/:templateId/signed_download_url/api",
            "params": [
              {
                "name": "templateId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download a template file"
        }
      ]
    }
  ],
  "bundled": true
}